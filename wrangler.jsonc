{
  "name": "adp-signaling",
  "main": "src/signaling/worker.ts",
  "compatibility_date": "2025-06-01",
  "routes": [
    { "pattern": "signaling.axiomid.app/*", "zone_name": "axiomid.app" }
  ],
  "compatibility_flags": ["nodejs_compat"],
  "vars": {
    "PROTOCOL_VERSION": "adp-v1",
    "MAX_AGENTS_PER_ROOM": "1000",
    "SESSION_TTL": "3600"
  }
}