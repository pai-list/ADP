{
  "name": "@pai/adp",
  "description": "Agent Discovery Protocol - Discovery + collaboration layer for AI agents",
  "version": "0.1.0",
  "author": "Mohamed Abdelaziz <momtaz2727@gmail.com>",
  "bugs": {
    "url": "https://github.com/pai-list/ADP/issues"
  },
  "dependencies": {
    "hono": "^4.6.5",
    "viem": "^2.21.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260724.1",
    "@types/node": "^26",
    "@types/ws": "^8.18.1",
    "@typescript-eslint/eslint-plugin": "^8.7.0",
    "@typescript-eslint/parser": "^8.7.0",
    "@vitest/coverage-v8": "^2.1.1",
    "eslint": "^9",
    "tsc-alias": "^1.8.10",
    "tsx": "^4.19.0",
    "typedoc": "^0.27.0",
    "typescript": "^5",
    "vitest": "^4.0.17",
    "wrangler": "^4.113.0"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./signaling": {
      "types": "./dist/signaling/index.d.ts",
      "import": "./dist/signaling/index.js"
    },
    "./protocol": {
      "types": "./dist/protocol/index.d.ts",
      "import": "./dist/protocol/index.js"
    },
    "./identity": {
      "types": "./dist/identity/index.d.ts",
      "import": "./dist/identity/index.js"
    },
    "./discovery": {
      "types": "./dist/discovery/index.d.ts",
      "import": "./dist/discovery/index.js"
    },
    "./sharing": {
      "types": "./dist/sharing/index.d.ts",
      "import": "./dist/sharing/index.js"
    },
    "./workspace": {
      "types": "./dist/workspace/index.d.ts",
      "import": "./dist/workspace/index.js"
    }
  },
  "homepage": "https://github.com/pai-list/ADP#readme",
  "keywords": [
    "adp",
    "agent",
    "cloudflare",
    "discovery",
    "mcp",
    "p2p",
    "protocol",
    "webrtc"
  ],
  "license": "MIT",
  "main": "dist/index.js",
  "repository": {
    "type": "git",
    "url": "https://github.com/pai-list/ADP"
  },
  "scripts": {
    "build": "tsc && tsc-alias",
    "deploy": "wrangler deploy",
    "dev": "wrangler dev",
    "generate": "tsx scripts/generate-did.ts",
    "lint": "eslint src --ext .ts",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "vitest run --config vitest.e2e.config.ts",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit"
  },
  "type": "module",
  "types": "dist/index.d.ts"
}
